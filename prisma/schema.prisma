generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  ADMIN
}

enum OrderStatus {
  PENDENTE
  PAGO
  EM_PRODUCAO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model User {
  id          String               @id @default(cuid())
  nome        String
  email       String               @unique
  telefone    String?
  senha       String
  role        UserRole             @default(CLIENT)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  orders      Order[]
  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  slug        String    @id
  name        String
  description String
  image       String
  products    Product[]
}

model Product {
  id               String      @id @default(cuid())
  name             String
  description      String
  price            Float
  promotionalPrice Float?
  promoQuantity    Int?
  promoPrice       Float?
  categorySlug     String
  category         Category    @relation(fields: [categorySlug], references: [slug])
  subcategory      String?
  images           String[]
  sizes            String[]
  colors           String[]    @default([])
  stock            Int         @default(0)
  weight           Float       @default(0.5)
  width            Float       @default(30)
  height           Float       @default(5)
  length           Float       @default(30)
  featured         Boolean     @default(false)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   Int         @unique
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?
  customerName  String
  customerPhone String
  customerEmail String?
  status        OrderStatus @default(PENDENTE)
  cep           String?
  endereco      String?
  numero        String?
  complemento   String?
  bairro        String?
  cidade        String?
  estado        String?
  documento     String?
  documentoTipo String?
  frete         Float       @default(0)
  desconto      Float       @default(0)
  retirada      Boolean     @default(false)
  total         Float
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id])
  productId   String?
  productName String
  price       Float
  quantity    Int
  size        String
  color       String?
}
